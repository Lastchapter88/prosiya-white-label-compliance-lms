rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isInstructor() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isInstructor());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'paymentStatus', 'paymentUpdatedAt', 'paymentUpdatedBy']))
      );
      allow delete: if false;
    }

    // --- Tenants Collection ---
    match /tenants/{tenantId} {
      allow read: if true; // Public for login page logic
      allow write: if isAdmin();
    }

    // --- Courses Collection ---
    match /courses/{courseId} {
      allow read: if true; // Public catalog? Or authenticated? "if isAuthenticated()"
      allow write: if isAdmin();
      
      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
        
        match /lessons/{lessonId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin();
        }
      }
    }

    // --- Enrollments ---
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()); // e.g. updating progress
    }

    // --- Study materials (catalog metadata) ---
    match /study_materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Study material access (admin approval required) ---
    match /material_access/{accessId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin() || isInstructor()
      );
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // --- Assessments ---
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isInstructor();
    }

    // --- Attempts ---
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin() || isInstructor());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if false; // High integrity: once submitted, no changes (use cloud functions)
    }

    // --- Evidence ---
    match /evidence/{evidenceId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin() || isInstructor());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || isInstructor(); // For reviews
    }

    // --- Certificates ---
    match /certificates/{certificateId} {
      allow read: if true; // Public verification? Or "if isAuthenticated()"
      allow write: if false; // Only generated by system (Cloud Functions)
    }

    // --- Audit Logs ---
    match /audit_logs/{logId} {
      allow read: if isAdmin(); // Only admins can audit
      allow create: if isAuthenticated(); // Users log their actions
      allow update, delete: if false; // WORM (Write Once Read Many) compliance
    }
  }
}
