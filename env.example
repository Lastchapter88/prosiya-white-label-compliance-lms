# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=prosiya_lms
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# S3 Storage (Optional)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=af-south-1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Compliance
ENABLE_DIGITAL_SIGNATURES=False

# Email (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---------------------------------------------------------------------------
# ProSiya AI Assistant (Qwen / DashScope) — Cloud Functions only
# Never put real keys here. Configure secrets for Firebase Functions.
# ---------------------------------------------------------------------------
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-plus
# Official DashScope international OpenAI-compatible base URL (override if needed):
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=45

# Optional frontend override for local emulator:
# VITE_CHAT_API_URL=http://127.0.0.1:5001/prosiya-e751a/us-central1/chat

